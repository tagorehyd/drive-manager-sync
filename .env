# Copy to .env and adjust. docker compose reads it automatically.
TZ=UTC
WEBUI_PORT=80
# Set to true when served over HTTPS (reverse proxy)
COOKIE_SECURE=false
# lax (default) | strict | none  (none = session cookie sent on cross-site requests; forces Secure/HTTPS)
COOKIE_SAMESITE=lax
# Comma-separated origins allowed for cross-site (CORS) requests; * = any origin
CORS_ORIGINS=*
# First-boot password required on /setup. Blank = generated, logged and stored in /config/setup-password
SETUP_PASSWORD=
SESSION_DAYS=7
# true = wipe the login and force /setup on next start (remove afterwards)
RESET_AUTH=false
# Optional comma-separated override of folder-picker roots (default /mnt,/data)
BROWSE_ROOTS=
# Media renamer LLM fallback (any OpenAI-compatible endpoint)
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
# Optional: Telegram defaults (can also be set in Settings)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
